APP_NAME=InvoiceIQ
APP_ENV=development
LOG_LEVEL=INFO

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.0
GROQ_MAX_TOKENS=8192
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_PRICING_MODEL=openai/gpt-oss-120b
GROQ_INPUT_PRICE_PER_MILLION_USD=0.15
GROQ_CACHED_INPUT_PRICE_PER_MILLION_USD=0.075
GROQ_OUTPUT_PRICE_PER_MILLION_USD=0.60
GROQ_PRICING_SOURCE_URL=https://console.groq.com/docs/model/openai/gpt-oss-120b
GROQ_PRICING_AS_OF=2026-11-22

TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_MIN_TEXT_CHARS=50
OCR_RENDER_DPI=300
OCR_AUTO_ROTATE=true

MAX_UPLOAD_MB=10
INVOICE_AMOUNT_TOLERANCE=0.01
